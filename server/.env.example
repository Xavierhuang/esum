# Copy to server/.env to run `npm run dev` with your real accounts and Claude. Never commit .env.
# Leave this file out (or set OPA_MODE=demo) for the demo with sample data and scripted replies.
# Setup steps: docs/OPERATIONS.md, "Use your real accounts".

OPA_MODE=live

# Claude API key from https://platform.claude.com (the worker is the only service that uses it)
OPA_ANTHROPIC_API_KEY=
# OPA_MODEL_ID=claude-opus-5-5
# OPA_MODEL_EFFORT=high

# Google OAuth client of type "Web application" with this authorized redirect URI:
#   http://127.0.0.1:8080/api/oauth/google/callback
OPA_GOOGLE_CLIENT_ID=
OPA_GOOGLE_CLIENT_SECRET=
# true while the Google app is in Testing mode (Google expires sign-ins after 7 days)
OPA_GOOGLE_OAUTH_TESTING=true

# Optional: a broker key for stored credentials. npm run dev creates one in server/data/dev-broker-kek if unset.
# OPA_BROKER_KEK=
